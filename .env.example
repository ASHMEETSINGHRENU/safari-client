# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# By default the app calls the API same-origin at /api/v1:
#   - local dev  -> Vite proxy in vite.config.ts -> http://localhost:5000
#   - production -> Vercel rewrite in vercel.json -> the live Render backend
# Leave VITE_API_BASE_URL unset for this normal path (no CORS involved).
#
# Set it ONLY to bypass the proxy and call a specific backend host directly,
# e.g. a staging API. Do NOT set a trailing slash.
# VITE_API_BASE_URL=https://safari-server-y9md.onrender.com
